<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client_Java.player.view.cards.LobbyLeaderboardCardView">
   <padding>
      <Insets bottom="10" left="10" right="10" top="10" />
   </padding>

   <Label fx:id="rankLabel" minWidth="50" textAlignment="CENTER" textFill="WHITE">
      <font>
         <Font name="Amatic SC Bold" size="24" />
      </font>
   </Label>

   <Label fx:id="usernameLabel" minWidth="200" textAlignment="LEFT" textFill="WHITE">
      <font>
         <Font name="Amatic SC Bold" size="24" />
      </font>
   </Label>

   <Label fx:id="pointsLabel" minWidth="100" textAlignment="CENTER" textFill="WHITE">
      <font>
         <Font name="Amatic SC Bold" size="24" />
      </font>
   </Label>
</HBox>
