<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="760.0" prefWidth="1300.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Client_Java.player.view.GameRoomView">

   <!-- RIGHT SIDE: round info, cat graphic, lives -->
   <right>
      <VBox spacing="20" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
         </padding>

         <!-- Round info -->
         <HBox spacing="10" alignment="CENTER_LEFT">
            <Text text="Round:">
               <font><Font size="53.0"/></font>
            </Text>
            <Label fx:id="roundLabel" text="R1">
               <font><Font size="52.0"/></font>
            </Label>
         </HBox>

         <!-- Cat graphic pieces -->
         <VBox spacing="5" alignment="CENTER">
            <ImageView fx:id="catShadow"
                       pickOnBounds="true" preserveRatio="true"
                       fitWidth="200.0" fitHeight="150.0">
               <image>
                  <Image url="@../../images/cat/cat-outline.png"/>
               </image>
            </ImageView>
            <ImageView fx:id="catTopHead" visible="false"
                       pickOnBounds="true" preserveRatio="true"
                       fitWidth="200.0" fitHeight="60.0">
               <image>
                  <Image url="@../../images/cat/top-head.png"/>
               </image>
            </ImageView>
            <ImageView fx:id="catEyes" visible="false"
                       pickOnBounds="true" preserveRatio="true"
                       fitWidth="150.0" fitHeight="40.0">
               <image>
                  <Image url="@../../images/cat/eyes.png"/>
               </image>
            </ImageView>
            <ImageView fx:id="catSnout" visible="false"
                       pickOnBounds="true" preserveRatio="true"
                       fitWidth="80.0"  fitHeight="50.0">
               <image>
                  <Image url="@../../images/cat/snout.png"/>
               </image>
            </ImageView>
            <ImageView fx:id="catLeftWhiskers" visible="false"
                       pickOnBounds="true" preserveRatio="true"
                       fitWidth="80.0"  fitHeight="80.0">
               <image>
                  <Image url="@../../images/cat/left-whiskers.png"/>
               </image>
            </ImageView>
            <ImageView fx:id="catRightWhiskers" visible="false"
                       pickOnBounds="true" preserveRatio="true"
                       fitWidth="80.0"  fitHeight="80.0">
               <image>
                  <Image url="@../../images/cat/right-whiskers.png"/>
               </image>
            </ImageView>
            <ImageView fx:id="catBottomHead" visible="false"
                       pickOnBounds="true" preserveRatio="true"
                       fitWidth="200.0" fitHeight="60.0">
               <image>
                  <Image url="@../../images/cat/bottom-head.png"/>
               </image>
            </ImageView>
         </VBox>

         <!-- Lives display -->
         <HBox spacing="5" alignment="CENTER">
            <Text text="Lives:">
               <font><Font size="43.0"/></font>
            </Text>
            <Label fx:id="lifeCountLabel" text="5">
               <font><Font size="47.0"/></font>
            </Label>
         </HBox>
      </VBox>
   </right>

   <!-- CENTER: title, blanks, alphabet -->
   <center>
      <VBox spacing="30" alignment="CENTER" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
         </padding>

         <!-- Game title -->
         <Label text="What's the Word?">
            <font><Font name="Marykate" size="60.0"/></font>
         </Label>

         <!-- Dynamically populated blanks -->
         <FlowPane fx:id="wordFlow"
                   hgap="10" vgap="10"
                   prefWrapLength="700"
                   alignment="CENTER">
            <padding>
               <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
         </FlowPane>

         <!-- Dynamically populated alphabet keys -->
         <FlowPane fx:id="alphabetFlow"
                   hgap="5" vgap="5"
                   prefWrapLength="700"
                   alignment="CENTER">
            <padding>
               <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
         </FlowPane>
      </VBox>
   </center>

</BorderPane>
