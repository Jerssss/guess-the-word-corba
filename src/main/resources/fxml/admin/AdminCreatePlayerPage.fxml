<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.Priority?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client_Java.admin.view.AdminCreateAccountPageView">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <VBox alignment="TOP_CENTER" spacing="5.0" fillWidth="true">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Label alignment="CENTER" text="ADD PLAYER">
               <font>
                  <Font name="Marykate" size="36.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" top="10.0" />
               </VBox.margin>
            </Label>

            <Label text="Full Name" textFill="#000000d9">
               <font>
                  <Font name="Marykate" size="24.0" />
               </font>
            </Label>
            <TextField fx:id="fullnameTextField" promptText="e.g Juan Tamad"
                       style="-fx-border-color: black; -fx-background-color: WHITE; -fx-background-radius: 10; -fx-border-radius: 10;">
               <font>
                  <Font name="Amatic SC Bold" size="22.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
            </TextField>

            <Label text="Username" textFill="#000000d9">
               <font>
                  <Font name="Marykate" size="24.0" />
               </font>
            </Label>
            <TextField fx:id="usernameTextField" promptText="e.g. JuanSisipagNa"
                       style="-fx-border-color: black; -fx-background-color: WHITE; -fx-background-radius: 10; -fx-border-radius: 10;">
               <font>
                  <Font name="Amatic SC Bold" size="22.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
            </TextField>

            <Label text="Password" textFill="#000000d9">
               <font>
                  <Font name="Marykate" size="24.0" />
               </font>
            </Label>
            <TextField fx:id="passwordTextField" promptText="e.g. secretNiJuan123"
                       style="-fx-border-color: black; -fx-background-color: WHITE; -fx-background-radius: 10; -fx-border-radius: 10;">
               <font>
                  <Font name="Amatic SC Bold" size="22.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="25.0" />
               </VBox.margin>
            </TextField>

            <Label fx:id="noticeLabel" alignment="CENTER" text="error message here" textFill="#ff0000" visible="false">
               <font>
                  <Font name="Arial Bold" size="14.0" />
               </font>
            </Label>

            <HBox alignment="CENTER" spacing="15">
               <children>
                  <Button fx:id="returnButton" mnemonicParsing="false" text="Return" style="-fx-border-color: transparent; -fx-background-color: transparent;">
                     <font>
                        <Font name="Marykate" size="30.0" />
                     </font>
                  </Button>
                  <Button fx:id="saveButton" mnemonicParsing="false" text="Save" style="-fx-border-color: transparent; -fx-background-color: transparent;">
                     <font>
                        <Font name="Marykate" size="30.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>